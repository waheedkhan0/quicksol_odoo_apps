<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Lead/Opportunity Form View -->
    <record id="crm_lead_view_form_inherit_lost_reason" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.lost.reason</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <field name="lost_reason_id" position="after">
                <field name="is_other_reason" invisible="1"/>
                <field invisible="not is_other_reason" name="custom_lost_reason" placeholder="Additional details about why the opportunity was lost..."/></field></field>
    </record>
    <!-- Extend Lost Reason Wizard -->
    <record id="crm_lead_lost_reason_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.lost.reason.form.inherit</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lost_feedback']" position="after">
                <field name="is_other_reason" invisible="1"/>
                <field invisible="not is_other_reason" name="custom_lost_reason" placeholder="Enter additional details for lost ..."/>
            </xpath></field>
    </record>
</odoo>
